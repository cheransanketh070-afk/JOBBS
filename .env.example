# ============================================================
# JOBBS — environment configuration
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real ".env" file to git or share it publicly.
# ============================================================

# --- Core Flask security ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# --- Site ---
SITE_URL=https://your-domain.com
SITE_NAME=JOBBS

# --- Database (SQLite file, free, no external service needed) ---
# Leave this unset to use the app's own absolute path (instance/jobbs.db
# next to this file) — the safest option. Only set this if you want a
# different database (e.g. a Postgres URL from a free-tier host).
# DATABASE_URL=sqlite:///instance/jobbs.db

# --- Google OAuth (for "Sign in with Google") ---
# Get these free from https://console.cloud.google.com/
# 1. Create a project -> APIs & Services -> Credentials
# 2. Create "OAuth client ID" -> Application type: Web application
# 3. Authorized redirect URI: https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Email verification (free Gmail SMTP, or any SMTP provider) ---
# Gmail: turn on 2-Step Verification, then create an "App Password":
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=JOBBS <your-gmail-address@gmail.com>
# If left blank, verification links are printed to the server log instead
# of emailed, so you can still test locally without SMTP credentials.

# --- Google Search Console / SEO ---
# Get this from https://search.google.com/search-console -> "HTML tag" method
GOOGLE_SITE_VERIFICATION=paste-the-content-value-of-the-meta-tag-here
# Get this from https://analytics.google.com/ (optional, free)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# --- Rate limiting / abuse control ---
RATELIMIT_STORAGE_URI=memory://

# --- Scraper behaviour ---
SCRAPE_MAX_RESULTS_CAP=50
SCRAPE_CONCURRENCY=5
